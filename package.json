{
  "name": "keycache",
  "productName": "Keycache",
  "version": "0.4.1",
  "description": "Keycache \u2014 key-value notes in your menu bar",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "node scripts/prefetch-electron.mjs",
    "test:e2e": "electron-vite build && npx playwright test --config tests/e2e/playwright.config.ts",
    "package": "electron-vite build && electron-builder --dir",
    "package:dev": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir -c.productName='Keycache Dev' -c.extraMetadata.productName='Keycache Dev' -c.appId=com.keycache.app.dev",
    "dist": "electron-vite build && electron-builder --publish never",
    "site:assets": "mkdir -p site/assets && cp assets/demo.gif site/assets/demo.gif",
    "site:images": "node scripts/gen-site-images.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "keywords": [],
  "license": "GPL-3.0-or-later"
}
